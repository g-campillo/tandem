{
	"HTML document": {
		"prefix": ["html5", "!"],
		"body": [
			"<!DOCTYPE html>",
			"<html lang=\"${1:en}\">",
			"<head>",
			"\t<meta charset=\"UTF-8\">",
			"\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
			"\t<title>${2:Document}</title>",
			"</head>",
			"<body>",
			"\t$0",
			"</body>",
			"</html>"
		],
		"description": "An HTML5 document."
	},
	"Div": {
		"prefix": "div",
		"body": "<div>$0</div>",
		"description": "A div element."
	},
	"Div with class": {
		"prefix": "divc",
		"body": "<div class=\"$1\">$0</div>",
		"description": "A div element with a class."
	},
	"Link": {
		"prefix": "a",
		"body": "<a href=\"${1:#}\">$0</a>",
		"description": "A hyperlink."
	},
	"Image": {
		"prefix": "img",
		"body": "<img src=\"$1\" alt=\"$2\">",
		"description": "An image."
	},
	"Stylesheet": {
		"prefix": "link",
		"body": "<link rel=\"stylesheet\" href=\"${1:style.css}\">",
		"description": "Links a stylesheet."
	},
	"Script": {
		"prefix": "script",
		"body": "<script src=\"${1:script.js}\"></script>",
		"description": "Loads a script."
	},
	"List": {
		"prefix": "ul",
		"body": ["<ul>", "\t<li>$0</li>", "</ul>"],
		"description": "An unordered list with one item."
	},
	"Form": {
		"prefix": "form",
		"body": ["<form action=\"$1\" method=\"${2|post,get|}\">", "\t$0", "</form>"],
		"description": "A form."
	},
	"Input": {
		"prefix": "input",
		"body": "<input type=\"${1|text,email,password,number,checkbox,radio|}\" name=\"$2\">",
		"description": "A form input."
	},
	"Button": {
		"prefix": "button",
		"body": "<button type=\"${1|button,submit,reset|}\">$0</button>",
		"description": "A button."
	},
	"Table": {
		"prefix": "table",
		"body": ["<table>", "\t<tr>", "\t\t<td>$0</td>", "\t</tr>", "</table>"],
		"description": "A table with one cell."
	}
}
