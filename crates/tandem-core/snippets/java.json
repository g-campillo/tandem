{
	"Main method": {
		"prefix": "main",
		"body": ["public static void main(String[] args) {", "\t$0", "}"],
		"description": "The program's main method."
	},
	"Print line": {
		"prefix": "sout",
		"body": "System.out.println($1);",
		"description": "Prints a line to standard output."
	},
	"Class": {
		"prefix": "class",
		"body": ["public class ${1:${TM_FILENAME_BASE}} {", "\t$0", "}"],
		"description": "A public class named after the file."
	},
	"Interface": {
		"prefix": "interface",
		"body": ["public interface ${1:${TM_FILENAME_BASE}} {", "\t$0", "}"],
		"description": "A public interface named after the file."
	},
	"Enum": {
		"prefix": "enum",
		"body": ["public enum ${1:${TM_FILENAME_BASE}} {", "\t$0", "}"],
		"description": "A public enum named after the file."
	},
	"Record": {
		"prefix": "record",
		"body": ["public record ${1:Name}($2) {", "}"],
		"description": "A public record."
	},
	"Method": {
		"prefix": "method",
		"body": ["${1:public} ${2:void} ${3:name}($4) {", "\t$0", "}"],
		"description": "A method."
	},
	"For loop with index": {
		"prefix": "fori",
		"body": ["for (int ${1:i} = 0; $1 < ${2:length}; $1++) {", "\t$0", "}"],
		"description": "A for loop over an index."
	},
	"For each loop": {
		"prefix": "foreach",
		"body": ["for (${1:var} ${2:item} : ${3:items}) {", "\t$0", "}"],
		"description": "A for loop over the elements of an array or collection."
	},
	"If": {
		"prefix": "if",
		"body": ["if (${1:condition}) {", "\t$0", "}"],
		"description": "An if statement."
	},
	"If else": {
		"prefix": "ifelse",
		"body": ["if (${1:condition}) {", "\t$2", "} else {", "\t$0", "}"],
		"description": "An if statement with an else branch."
	},
	"While loop": {
		"prefix": "while",
		"body": ["while (${1:condition}) {", "\t$0", "}"],
		"description": "A while loop."
	},
	"Try catch": {
		"prefix": "try",
		"body": ["try {", "\t$1", "} catch (${2:Exception} ${3:e}) {", "\t$0", "}"],
		"description": "A try statement with a catch clause."
	},
	"Switch": {
		"prefix": "switch",
		"body": [
			"switch (${1:value}) {",
			"\tcase ${2:value} -> $0;",
			"\tdefault -> {",
			"\t}",
			"}"
		],
		"description": "A switch statement with arrow cases."
	},
	"Test": {
		"prefix": "test",
		"body": ["@Test", "void ${1:name}() {", "\t$0", "}"],
		"description": "A JUnit test method."
	}
}
